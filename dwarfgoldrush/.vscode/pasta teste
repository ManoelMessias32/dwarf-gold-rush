@Composable
fun LoginScreen(navController: NavHostController) {
    var email by remember { mutableStateOf("") }
    var password by remember { mutableStateOf("") }
    var name by remember { mutableStateOf("") }
    var wallet by remember { mutableStateOf("") }
    var isRegistering by remember { mutableStateOf(false) }
    var termsAccepted by remember { mutableStateOf(false) }
    var privacyPolicyAccepted by remember { mutableStateOf(false) }
    val context = LocalContext.current
    val auth = Firebase.auth
    val uriHandler = LocalUriHandler.current

    val onAuthSuccess = { navController.navigate("main") { popUpTo("login") { inclusive = true } } }

    LaunchedEffect(Unit) { if (auth.currentUser != null) { onAuthSuccess() } }

    ScreenWithBackground {
        Column(
            modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(horizontal = 32.dp),
            verticalArrangement = Arrangement.Center,
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            val title = if (isRegistering) "Criar Conta" else "Login"
            Text(title, style = MaterialTheme.typography.headlineLarge, color = Color.White)
            Spacer(modifier = Modifier.height(24.dp))

            TextField(value = email, onValueChange = { email = it }, label = { Text("E-mail") })
            Spacer(modifier = Modifier.height(8.dp))
            TextField(value = password, onValueChange = { password = it }, label = { Text("Senha") }, visualTransformation = PasswordVisualTransformation())

            if (isRegistering) {
                Spacer(modifier = Modifier.height(8.dp))
                TextField(value = name, onValueChange = { name = it }, label = { Text("Nome de Usuário") })
                Spacer(modifier = Modifier.height(8.dp))
                TextField(value = wallet, onValueChange = { wallet = it }, label = { Text("Endereço da Carteira (BEP-20)") })
                Spacer(modifier = Modifier.height(16.dp))
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Checkbox(checked = termsAccepted, onCheckedChange = { termsAccepted = it })
                    Spacer(modifier = Modifier.width(8.dp))
                    ClickableText(text = AnnotatedString("Eu li e aceito os Termos de Serviço"), style = TextStyle(color = Color.White, textDecoration = TextDecoration.Underline), onClick = { uriHandler.openUri(TERMS_OF_SERVICE_URL) })
                }
                Spacer(modifier = Modifier.height(8.dp))
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Checkbox(checked = privacyPolicyAccepted, onCheckedChange = { privacyPolicyAccepted = it })
                    Spacer(modifier = Modifier.width(8.dp))
                    ClickableText(text = AnnotatedString("Eu li e aceito a Política de Privacidade"), style = TextStyle(color = Color.White, textDecoration = TextDecoration.Underline), onClick = { uriHandler.openUri(PRIVACY_POLICY_URL) })
                }
            }

            Spacer(modifier = Modifier.height(24.dp))

            val isButtonEnabled = if (isRegistering) email.isNotBlank() && password.isNotBlank() && name.isNotBlank() && wallet.isNotBlank() && termsAccepted && privacyPolicyAccepted else email.isNotBlank() && password.isNotBlank()

            if (isRegistering) {
                Button(onClick = {
                    auth.createUserWithEmailAndPassword(email, password).addOnCompleteListener { task ->
                        if (task.isSuccessful) {
                            val userId = task.result?.user?.uid
                            if (userId != null) {
                                val firestoreDb = Firebase.firestore
                                val realtimeDb = Firebase.database.reference
                                val userProfile = UserProfile(name, wallet)
                                val initialGameState = GameState(lastNuggetMineTime = System.currentTimeMillis())
                                firestoreDb.collection("users").document(userId).set(userProfile)
                                realtimeDb.child("gamestates").child(userId).setValue(initialGameState)
                                onAuthSuccess()
                            }
                        } else {
                            val message = when (task.exception) {
                                is FirebaseAuthUserCollisionException -> "Este e-mail já está em uso."
                                is FirebaseAuthWeakPasswordException -> "A senha é muito fraca. Use pelo menos 6 caracteres."
                                else -> "Falha ao criar conta: ${task.exception?.message}"
                            }
                            Toast.makeText(context, message, Toast.LENGTH_LONG).show()
                        }
                    }
                }, enabled = isButtonEnabled, colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary, contentColor = Color.White)) { Text("Confirmar Criação") }
                Spacer(modifier = Modifier.height(8.dp))
                TextButton(onClick = { isRegistering = false }) { Text("Já tem uma conta? Fazer Login", fontSize = 16.sp, color = Color.White, fontWeight = FontWeight.Bold) }
            } else {
                Button(onClick = {
                    auth.signInWithEmailAndPassword(email, password).addOnCompleteListener { task ->
                        if (task.isSuccessful) onAuthSuccess() else Toast.makeText(context, "Falha no login. Verifique seu e-mail e senha.", Toast.LENGTH_LONG).show()
                    }
                 }, enabled = isButtonEnabled, colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary, contentColor = Color.White)) { Text("Login") }
                Spacer(modifier = Modifier.height(8.dp))
                TextButton(onClick = { isRegistering = true }) { Text("Não tem uma conta? Criar Agora", fontSize = 16.sp, color = Color.White, fontWeight = FontWeight.Bold) }
                Spacer(modifier = Modifier.height(8.dp))
                TextButton(onClick = {
                    if (email.isNotBlank()) {
                        auth.sendPasswordResetEmail(email).addOnCompleteListener { task ->
                            val message = if (task.isSuccessful) "E-mail de redefinição de senha enviado para $email." else "Falha ao enviar e-mail: ${task.exception?.message}"
                            Toast.makeText(context, message, Toast.LENGTH_LONG).show()
                        }
                    } else {
                        Toast.makeText(context, "Por favor, insira seu e-mail.", Toast.LENGTH_SHORT).show()
                    }
                }) { Text("Esqueceu a senha?", fontSize = 16.sp, color = Color.White, fontWeight = FontWeight.Bold) }
            }
        }
    }
}

