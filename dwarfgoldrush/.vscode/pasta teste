// --- Helper Functions ---
fun GameState.isMiningActive(): Boolean = this.activeMiningStartTime > 0 && this.getActiveMiningTimeLeft(System.currentTimeMillis()) > 0
fun GameState.getActiveMiningTimeLeft(currentTime: Long): Long = (this.accumulatedMiningTimeMs - (currentTime - this.activeMiningStartTime)).coerceAtLeast(0)
fun GameState.getNuggetsPerCycle(): Int {
    val pickaxeTier = this.upgrades["pickaxe_tier"] ?: 0
    var cycleNuggets = when (pickaxeTier) {
        1 -> 2
        2 -> 4
        3 -> 8
        else -> 1
    }
    if (this.activeBoosts.containsKey("nugget_boost") && this.activeBoosts["nugget_boost"]!! > System.currentTimeMillis()) {
        cycleNuggets *= 2
    }
    return cycleNuggets
}

fun formatDuration(millis: Long): String {
    val hours = TimeUnit.MILLISECONDS.toHours(millis)
    val minutes = TimeUnit.MILLISECONDS.toMinutes(millis) % 60
    val seconds = TimeUnit.MILLISECONDS.toSeconds(millis) % 60
    return String.format(Locale.getDefault(), "%02d:%02d:%02d", hours, minutes, seconds)
}

fun formatWalletAddress(address: String): String {
    if (address.length < 11) return address
    return "${address.take(6)}...${address.takeLast(4)}"
}

fun loadRewardedAd(activity: Activity, onAdLoaded: (RewardedAd) -> Unit, onAdFailed: (LoadAdError) -> Unit) {
    val adRequest = AdRequest.Builder().build()
    RewardedAd.load(activity, YOUR_REWARDED_AD_UNIT_ID, adRequest, object : RewardedAdLoadCallback() {
        override fun onAdFailedToLoad(adError: LoadAdError) { onAdFailed(adError) }
        override fun onAdLoaded(rewardedAd: RewardedAd) { onAdLoaded(rewardedAd) }
    })
}

