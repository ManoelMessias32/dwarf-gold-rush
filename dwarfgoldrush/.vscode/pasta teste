@Composable
fun MiningScreenContent() {
    val userId = Firebase.auth.currentUser?.uid ?: return
    val firestoreDb = Firebase.firestore
    val realtimeDb = Firebase.database.reference.child("gamestates").child(userId)

    var gameState by remember { mutableStateOf(GameState()) }
    var userProfile by remember { mutableStateOf(UserProfile()) }
    var displayedTime by remember { mutableLongStateOf(0L) }

    DisposableEffect(userId) {
        val userListener = firestoreDb.collection("users").document(userId).addSnapshotListener { snapshot, _ ->
            snapshot?.toObject(UserProfile::class.java)?.let { userProfile = it }
        }

        val gameStateListener = object : ValueEventListener {
            override fun onDataChange(snapshot: DataSnapshot) {
                val dbState = snapshot.getValue<GameState>() ?: return
                val now = System.currentTimeMillis()

                if (dbState.isMiningActive()) {
                    val timeSinceLastMine = now - dbState.lastNuggetMineTime
                    val activeTimeSoFar = now - dbState.activeMiningStartTime
                    val totalMiningDuration = dbState.accumulatedMiningTimeMs

                    if (activeTimeSoFar < totalMiningDuration) {
                        val nuggetsGained = (timeSinceLastMine / NUGGET_GAIN_INTERVAL_MS) * dbState.getNuggetsPerCycle()
                        if (nuggetsGained > 0) {
                            realtimeDb.runTransaction(object : Transaction.Handler {
                                override fun doTransaction(currentData: MutableData): Transaction.Result {
                                    val currentState = currentData.getValue<GameState>() ?: return Transaction.abort()
                                    val updatedState = currentState.copy(
                                        nuggets = currentState.nuggets + nuggetsGained,
                                        lastNuggetMineTime = now
                                    )
                                    currentData.value = updatedState
                                    return Transaction.success(currentData)
                                }
                                override fun onComplete(error: DatabaseError?, committed: Boolean, currentData: DataSnapshot?) {
                                    // Transaction completed
                                }
                            })
                        }
                    }
                }
                gameState = dbState
            }

            override fun onCancelled(error: DatabaseError) {
                Log.e("Firebase", "Erro ao ler dados: ${error.message}")
            }
        }

        realtimeDb.addValueEventListener(gameStateListener)

        onDispose {
            userListener.remove()
            realtimeDb.removeEventListener(gameStateListener)
        }
    }

    LaunchedEffect(gameState) {
        val now = System.currentTimeMillis()
        displayedTime = if (gameState.isMiningActive()) gameState.getActiveMiningTimeLeft(now) else gameState.accumulatedMiningTimeMs
        if (gameState.isMiningActive()) {
            while (isActive && displayedTime > 0) {
                delay(1000)
                val current = System.currentTimeMillis()
                displayedTime = gameState.getActiveMiningTimeLeft(current)
            }
        }
    }

    val context = LocalContext.current
    val activity = context as? Activity
    val isAdOnCooldown = gameState.adCooldownStartedAt > 0 && System.currentTimeMillis() - gameState.adCooldownStartedAt < AD_COOLDOWN_DURATION_MS
    val canStartMining = gameState.accumulatedMiningTimeMs > 0 && !gameState.isMiningActive()

    Column(modifier = Modifier.fillMaxSize().padding(16.dp), verticalArrangement = Arrangement.SpaceBetween, horizontalAlignment = Alignment.CenterHorizontally) {
        InfoBox(modifier = Modifier.fillMaxWidth()) {
            Text(userProfile.name, color = Color.White, fontWeight = FontWeight.Bold, fontSize = 20.sp)
            Spacer(modifier = Modifier.height(4.dp))
            Text(formatWalletAddress(userProfile.walletAddress), color = Color.Gray, fontSize = 14.sp)
        }

        Column(horizontalAlignment = Alignment.CenterHorizontally) {
            InfoBox {
                Text("Nuggets: ${gameState.nuggets}", style = MaterialTheme.typography.headlineMedium, color = Color.White)
                Spacer(modifier = Modifier.height(8.dp))
                LinearProgressIndicator(progress = { (gameState.nuggets.toFloat() / NUGGETS_GOAL.toFloat()).coerceIn(0f, 1f) }, modifier = Modifier.height(8.dp).fillMaxWidth(0.8f))
            }
            Spacer(modifier = Modifier.height(16.dp))
            if (canStartMining) {
                Button(onClick = {
                    realtimeDb.updateChildren(mapOf("activeMiningStartTime" to System.currentTimeMillis(), "lastNuggetMineTime" to System.currentTimeMillis()))
                }) { Text("Iniciar Mineração") }
            }
        }

        Column(modifier = Modifier.fillMaxWidth(), horizontalAlignment = Alignment.End) {
            Text("Anúncios vistos: ${gameState.adsWatchedInCycle}/${AD_WATCH_LIMIT}", color = Color.White)
            Spacer(modifier = Modifier.height(4.dp))
            Button(onClick = {
                if (activity != null) {
                    loadRewardedAd(activity,
                        onAdLoaded = { rewardedAd ->
                            rewardedAd.show(activity) {
                                if (isAdOnCooldown) {
                                    Toast.makeText(context, "Período de espera. Você pode ver anúncios, mas não ganhará tempo agora.", Toast.LENGTH_LONG).show()
                                } else {
                                    realtimeDb.runTransaction(object : Transaction.Handler {
                                        override fun doTransaction(currentData: MutableData): Transaction.Result {
                                            val currentState = currentData.getValue<GameState>() ?: return Transaction.success(currentData)

                                            val newAdsWatched = currentState.adsWatchedInCycle + 1
                                            val newAdCooldownStartedAt = if (newAdsWatched >= AD_WATCH_LIMIT) System.currentTimeMillis() else currentState.adCooldownStartedAt
                                            val newTime = currentState.accumulatedMiningTimeMs + MINING_TIME_PER_AD_MS
                                            
                                            val updatedState = currentState.copy(
                                                accumulatedMiningTimeMs = newTime,
                                                adsWatchedInCycle = newAdsWatched,
                                                adCooldownStartedAt = newAdCooldownStartedAt
                                            )
                                            currentData.value = updatedState
                                            return Transaction.success(currentData)
                                        }

                                        override fun onComplete(error: DatabaseError?, committed: Boolean, currentData: DataSnapshot?) {
                                            if (committed) {
                                                Toast.makeText(context, "+36 minutos de tempo de mineração acumulado!", Toast.LENGTH_SHORT).show()
                                            }
                                        }
                                    })
                                }
                            }
                        },
                        onAdFailed = { error ->
                            Log.e("MiningScreenContent", "Ad failed to load: Code ${error.code} - ${error.message}")
                            Toast.makeText(context, "Anúncio não disponível no momento. Tente mais tarde.", Toast.LENGTH_SHORT).show()
                        }
                    )
                }
            }) { Text("Ver Anúncio") }

            if (isAdOnCooldown) {
                val remaining = AD_COOLDOWN_DURATION_MS - (System.currentTimeMillis() - gameState.adCooldownStartedAt)
                Text("Tempo para recompensas:", color = Color.Yellow, fontSize = 14.sp, modifier = Modifier.padding(top = 8.dp))
                Text(formatDuration(remaining), color = Color.White, fontSize = 12.sp)
            }
            Spacer(modifier = Modifier.height(8.dp))
            val progressBarProgress = if (gameState.isMiningActive()) displayedTime.toFloat() / gameState.accumulatedMiningTimeMs.toFloat() else displayedTime.toFloat() / (AD_WATCH_LIMIT * MINING_TIME_PER_AD_MS).toFloat()
            Text(if (gameState.isMiningActive()) "Tempo de Mineração" else "Tempo Acumulado", color = Color.White)
            LinearProgressIndicator(progress = { progressBarProgress.coerceIn(0f, 1f) }, modifier = Modifier.fillMaxWidth(0.7f))
            Text(formatDuration(displayedTime), color = Color.White, modifier = Modifier.align(Alignment.End))
        }
    }
}

@Composable
fun StoreScreenContent() {
    val userId = Firebase.auth.currentUser?.uid ?: return
    val realtimeDb = Firebase.database.reference.child("gamestates").child(userId)
    val context = LocalContext.current

    var gameState by remember { mutableStateOf(GameState()) }

    DisposableEffect(userId) {
        val listener = object : ValueEventListener {
            override fun onDataChange(snapshot: DataSnapshot) {
                snapshot.getValue<GameState>()?.let { gameState = it }
            }
            override fun onCancelled(error: DatabaseError) { Log.e("StoreScreen", "DB error: ${error.message}") }
        }
        realtimeDb.addValueEventListener(listener)
        onDispose { realtimeDb.removeEventListener(listener) }
    }

    val storeItems = remember {
        listOf(
            StoreItem.Upgrade("pickaxe_tier_1", "Picareta de Ferro", "Gera 2 nuggets por ciclo.", 500, 1),
            StoreItem.Upgrade("pickaxe_tier_2", "Picareta de Ouro", "Gera 4 nuggets por ciclo.", 2500, 2),
            StoreItem.Upgrade("pickaxe_tier_3", "Picareta de Diamante", "Gera 8 nuggets por ciclo.", 10000, 3),
            StoreItem.Boost("nugget_boost", "Cerveja de Anão", "Dobra a produção de nuggets por 1 hora.", 200, 3600000L),
            StoreItem.InstantReward("treasure_map", "Mapa do Tesouro", "Recompensa instantânea de 1000-3000 nuggets.", 1500, 1000, 3000)
        )
    }

    Column(modifier = Modifier.fillMaxSize().padding(16.dp).verticalScroll(rememberScrollState())) {
        Text("Loja de Melhorias", style = MaterialTheme.typography.headlineMedium, color = Color.White)
        Text("Seus Nuggets: ${gameState.nuggets}", color = Color.White)
        Spacer(modifier = Modifier.height(16.dp))

        storeItems.forEach { item ->
            val currentTier = gameState.upgrades["pickaxe_tier"] ?: 0
            val isPurchasable = when (item) {
                is StoreItem.Upgrade -> gameState.nuggets >= item.cost && item.tier == currentTier + 1
                is StoreItem.Boost -> gameState.nuggets >= item.cost && !(gameState.activeBoosts.containsKey(item.id) && gameState.activeBoosts[item.id]!! > System.currentTimeMillis())
                is StoreItem.InstantReward -> gameState.nuggets >= item.cost
            }
            val buttonText = when (item) {
                is StoreItem.Upgrade -> if (item.tier <= currentTier) "Adquirido" else "Comprar"
                is StoreItem.Boost -> if (gameState.activeBoosts.containsKey(item.id) && gameState.activeBoosts[item.id]!! > System.currentTimeMillis()) "Ativo" else "Comprar"
                is StoreItem.InstantReward -> "Comprar"
            }

            Card(modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp)) {
                Row(modifier = Modifier.padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
                    Column(modifier = Modifier.weight(1f)) {
                        Text(item.name, style = MaterialTheme.typography.titleMedium)
                        Text(item.description, style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(top = 4.dp, bottom = 8.dp))
                        Text("Custo: ${item.cost} nuggets", style = MaterialTheme.typography.bodySmall, fontWeight = FontWeight.Bold)
                    }
                    Button(onClick = {
                        if (isPurchasable) {
                            realtimeDb.runTransaction(object : Transaction.Handler {
                                override fun doTransaction(currentData: MutableData): Transaction.Result {
                                    val currentState = currentData.getValue<GameState>() ?: return Transaction.success(currentData)

                                    if (currentState.nuggets < item.cost) return Transaction.abort()

                                    var newNuggets = currentState.nuggets - item.cost
                                    var newUpgrades = currentState.upgrades
                                    var newActiveBoosts = currentState.activeBoosts

                                    when (item) {
                                        is StoreItem.Upgrade -> {
                                            newUpgrades = newUpgrades + ("pickaxe_tier" to item.tier)
                                            // Salva upgrade no Firebase
                                            userRef.child("upgrades").child("pickaxe_tier").setValue(item.tier)
                                        }

                                        is StoreItem.Boost -> {
                                            val endTime = System.currentTimeMillis() + item.durationMs
                                            newActiveBoosts = newActiveBoosts + (item.id to endTime)
                                            // Salva boost no Firebase
                                            userRef.child("boosts").child(item.id).setValue(endTime)
                                        }

                                        is StoreItem.InstantReward -> {
                                            val reward = Random.nextLong(item.minReward, item.maxReward + 1)
                                            newNuggets += reward

                                            // ATUALIZA NO FIREBASE
                                            userRef.child("nuggets").get().addOnSuccessListener { snapshot ->
                                                val current = snapshot.getValue(Long::class.java) ?: 0L
                                                userRef.child("nuggets").setValue(current + reward)
                                            }

                                            // TOAST SEGURO (sem activity)
                                            MainScope().launch {
                                                Toast.makeText(context, "Você encontrou $reward nuggets!", Toast.LENGTH_SHORT).show()
                                            }
                                        }
                                    }
                                        }
                                    }
                                    val updatedState = currentState.copy(nuggets = newNuggets, upgrades = newUpgrades, activeBoosts = newActiveBoosts)
                                    currentData.value = updatedState
                                    return Transaction.success(currentData)
                                }
                                override fun onComplete(error: DatabaseError?, committed: Boolean, currentData: DataSnapshot?) {}
                            })
                        }
                    }, enabled = isPurchasable) { Text(buttonText) }
                }
            }
        }
    }
}

