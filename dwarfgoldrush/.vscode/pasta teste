// --- Data Classes ---
data class GameState(
    val nuggets: Long = 0L,
    val accumulatedMiningTimeMs: Long = 0L,
    val activeMiningStartTime: Long = 0L, // Timestamp of when active mining started
    val lastNuggetMineTime: Long = 0L, // Timestamp of the last time a nugget was mined
    val adCooldownStartedAt: Long = 0L,
    val adsWatchedInCycle: Int = 0,
    val upgrades: Map<String, Int> = emptyMap(), // e.g., {"pickaxe_tier": 2}
    val activeBoosts: Map<String, Long> = emptyMap() // e.g., {"nugget_boost_end_time": 123456L}
)

data class UserProfile(
    val name: String = "",
    val walletAddress: String = ""
)

sealed class StoreItem(
    open val id: String,
    open val name: String,
    open val description: String,
    open val cost: Long
) {
    data class Upgrade(
        override val id: String,
        override val name: String,
        override val description: String,
        override val cost: Long,
        val tier: Int
    ) : StoreItem(id, name, description, cost)

    data class Boost(
        override val id: String,
        override val name: String,
        override val description: String,
        override val cost: Long,
        val durationMs: Long
    ) : StoreItem(id, name, description, cost)

     data class InstantReward(
        override val id: String,
        override val name: String,
        override val description: String,
        override val cost: Long,
        val minReward: Long,
        val maxReward: Long
    ) : StoreItem(id, name, description, cost)
}

